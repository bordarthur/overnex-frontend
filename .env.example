# Só variáveis públicas (VITE_*): tudo aqui vai parar no bundle do navegador. Nunca coloque segredos.

# De onde vêm os dados: "mock" (fixture, padrão) ou "api" (API real em /api; em dev, o Vite repassa
# para http://127.0.0.1:8000).
VITE_API_MODO=mock

# Atraso simulado do cliente mock, em milissegundos.
VITE_MOCK_ATRASO_MS=300

# Estado da Visão geral no mock: completo (padrão), vazio, erro ou sem-permissao.
# VITE_MOCK_CENARIO=completo

# Login: "fake" (padrão; qualquer e-mail entra, a senha "errada" é recusada) ou "api" (rotas /api/auth/*
# da API, com e-mail e senha de verdade). Dá para usar o login fake com VITE_API_MODO=api.
VITE_AUTH_MODO=fake

# Usuário do token fake (Bearer fake:<object_id>), aceito só pela API local com AUTH_FAKE=1.
# Padrão: usuário de desenvolvimento, ligado à PJ Cortes (0d000000-0000-4000-8000-0000000001a1).
# No seed do Supabase local: Ana (…00000000000a) e Bruno (…00000000000b).
# VITE_AUTH_FAKE_OBJECT_ID=0d000000-0000-4000-8000-0000000001a1
