# Valores do build de produção (npm run build, no Cloudflare e local). Versionado de propósito: só
# variáveis VITE_ públicas, nunca segredo. O .env local não passa por cima deste arquivo no build; uma
# variável de ambiente passa (ex.: VITE_API_MODO=mock no build do Cloudflare, para uma demonstração).
VITE_API_MODO=api
VITE_AUTH_MODO=api
